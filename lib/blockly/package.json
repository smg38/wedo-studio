{
  "name": "blockly",
  "version": "13.2.1",
  "description": "Blockly is a library for building visual programming editors.",
  "keywords": [
    "blockly"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaspberryPiFoundation/blockly.git"
  },
  "bugs": {
    "url": "https://github.com/RaspberryPiFoundation/blockly/issues"
  },
  "homepage": "https://blockly.com",
  "author": {
    "name": "Neil Fraser"
  },
  "browser": {
    "jsdom": false
  },
  "imports": {
    "#core/*": "./build/src/core/*",
    "#generators/*": "./build/src/generators/*"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "umd": "./blockly.min.js",
      "default": "./index.js"
    },
    "./core": {
      "types": "./core.d.ts",
      "node": "./core-node.js",
      "import": "./blockly.mjs",
      "default": "./blockly_compressed.js"
    },
    "./blocks": {
      "types": "./blocks.d.ts",
      "import": "./blocks.mjs",
      "default": "./blocks_compressed.js"
    },
    "./dart": {
      "types": "./dart.d.ts",
      "import": "./dart.mjs",
      "default": "./dart_compressed.js"
    },
    "./lua": {
      "types": "./lua.d.ts",
      "import": "./lua.mjs",
      "default": "./lua_compressed.js"
    },
    "./javascript": {
      "types": "./javascript.d.ts",
      "import": "./javascript.mjs",
      "default": "./javascript_compressed.js"
    },
    "./php": {
      "types": "./php.d.ts",
      "import": "./php.mjs",
      "default": "./php_compressed.js"
    },
    "./python": {
      "types": "./python.d.ts",
      "import": "./python.mjs",
      "default": "./python_compressed.js"
    },
    "./msg/*": {
      "types": "./msg/*.d.ts",
      "import": "./msg/*.mjs",
      "default": "./msg/*.js"
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@blockly/block-test": "^13.1.0",
    "@hyperjump/browser": "^1.3.1",
    "@hyperjump/json-schema": "^1.17.6",
    "@microsoft/api-documenter": "7.30.7",
    "@microsoft/api-extractor": "^7.58.9",
    "ajv": "^8.20.0",
    "async-done": "^2.0.0",
    "chai": "^6.2.2",
    "concurrently": "^10.0.4",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "conventional-recommended-bump": "^12.0.0",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "google-closure-compiler": "^20260629.0.0",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-gzip": "^1.4.2",
    "gulp-header": "^2.0.12",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-umd": "^2.0.0",
    "http-server": "^14.1.1",
    "jsdom": "29.1.1",
    "json5": "^2.2.3",
    "markdown-tables-to-json": "^0.1.7",
    "mocha": "^11.7.6",
    "patch-package": "^8.0.1",
    "puppeteer-core": "^25.3.0",
    "readline-sync": "^1.4.10",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "webdriverio": "^9.30.0",
    "yargs": "^18.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "jsdom": ">=27.4.0 <30.0.0"
  },
  "type": "commonjs"
}